<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="karate.http" level="TRACE" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="karate.scenario" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="karate.runtime" level="WARN" additivity="false"/>
    <logger name="io.karatelabs" level="WARN" additivity="false"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
